# Generate a random secret of at least 32 characters before starting.
PAYLOAD_SECRET=
DATABASE_URI=file:./data/payload.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloud only: DATABASE_URI=libsql://your-database.turso.io
DATABASE_AUTH_TOKEN=
# Vercel Turso integration sets these aliases; they take priority.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Private one-time bootstrap. Do not add these to Vercel or commit their values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
